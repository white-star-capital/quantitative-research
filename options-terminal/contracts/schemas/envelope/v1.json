{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://options-terminal/contracts/schemas/envelope/v1.json",
  "title": "Model run envelope v1",
  "description": "CONTRACTS.md §2. The payload itself is validated separately against schemas/payloads/<kind>/v<version>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version", "run_id", "slot_id", "implementation_id", "implementation_version",
    "scope", "status", "as_of", "started_at", "finished_at", "inputs", "code", "warnings",
    "payload_kind", "payload_version", "payload"
  ],
  "properties": {
    "envelope_version": { "const": "1" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slot_id": { "$ref": "#/$defs/identifier" },
    "implementation_id": { "$ref": "#/$defs/identifier" },
    "implementation_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["success", "failed"] },
    "as_of": { "$ref": "#/$defs/utc_timestamp" },
    "started_at": { "$ref": "#/$defs/utc_timestamp" },
    "finished_at": { "$ref": "#/$defs/utc_timestamp" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "hash"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "snapshot_at"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "snapshot_at": { "$ref": "#/$defs/utc_timestamp" }
            }
          }
        },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha"],
      "properties": { "git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" } }
    },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "payload_kind": { "enum": ["scalar_set", "curve", "surface", "timeseries", "table", "composite"] },
    "payload_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "payload": { "type": ["object", "null"] },
    "error": { "$ref": "#/$defs/message" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "required": ["error"],
        "properties": { "payload": { "type": "null" } }
      },
      "else": {
        "not": { "required": ["error"] },
        "properties": { "payload": { "type": "object" } }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
