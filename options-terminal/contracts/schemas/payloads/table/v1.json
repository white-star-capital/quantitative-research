{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://options-terminal/contracts/schemas/payloads/table/v1.json",
  "title": "table v1. C-4: every row has one cell per column, and each cell matches its column type or is null (runner-checked).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "columns",
    "rows"
  ],
  "properties": {
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "number",
              "string",
              "timestamp",
              "date",
              "boolean"
            ]
          },
          "unit": {
            "$ref": "#/$defs/unit"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "scale"
      ],
      "properties": {
        "quantity": {
          "enum": [
            "implied_vol",
            "realized_vol",
            "vol_spread",
            "price",
            "price_usd",
            "delta",
            "gamma",
            "vega",
            "theta",
            "rate",
            "ratio",
            "probability",
            "yield_annualized",
            "bps",
            "strike",
            "moneyness_log",
            "moneyness_simple",
            "delta_bucket",
            "tenor_days",
            "expiry_date",
            "timestamp",
            "count",
            "other"
          ]
        },
        "scale": {
          "enum": [
            "decimal",
            "percent",
            "bps",
            "absolute"
          ]
        },
        "convention": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
