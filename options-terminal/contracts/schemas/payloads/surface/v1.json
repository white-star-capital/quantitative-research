{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://options-terminal/contracts/schemas/payloads/surface/v1.json",
  "title": "surface v1: z(x, y). C-4: z.values is len(y) rows of len(x), row-major by y (runner-checked).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "x",
    "y",
    "z"
  ],
  "properties": {
    "x": {
      "$ref": "#/$defs/axis"
    },
    "y": {
      "$ref": "#/$defs/axis"
    },
    "z": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "unit",
        "values"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "scale"
      ],
      "properties": {
        "quantity": {
          "enum": [
            "implied_vol",
            "realized_vol",
            "vol_spread",
            "price",
            "price_usd",
            "delta",
            "gamma",
            "vega",
            "theta",
            "rate",
            "ratio",
            "probability",
            "yield_annualized",
            "bps",
            "strike",
            "moneyness_log",
            "moneyness_simple",
            "delta_bucket",
            "tenor_days",
            "expiry_date",
            "timestamp",
            "count",
            "other"
          ]
        },
        "scale": {
          "enum": [
            "decimal",
            "percent",
            "bps",
            "absolute"
          ]
        },
        "convention": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "unit",
        "values"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
