  "query": "SELECT run_id, slot_id, implementation_id, role, as_of, envelope\n               FROM model_runs\n               WHERE slot_id = $1 AND scope_key = $2 AND role = $3 AND status = 'success'\n                 AND ($4::text IS NULL OR implementation_id = $4)\n               ORDER BY as_of DESC, run_id DESC\n               LIMIT 1",
