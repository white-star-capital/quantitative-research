# `make start` creates .env with random passwords on first run. Never commit .env.
# Values only, no inline comments (make reads this file too).

# Always: passwords for the runner and api logins (any long random string)
RUNNER_DB_PASSWORD=change-me
API_DB_PASSWORD=change-me
FRONTEND_PORT=3000

# Local Postgres container (used when SUPABASE_PROJECT_REF is not set)
POSTGRES_PASSWORD=change-me

# Supabase (set all three to use it instead of the local container; then `make supabase-init` once)
# Project ID: Project Settings > General > Project ID
# Pooler host: Connect > Session pooler > host (aws-0-<region>.pooler.supabase.com)
# DB password: Project Settings > Database > database password (used by supabase-init only)
# SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# SUPABASE_POOLER_HOST=aws-0-eu-central-1.pooler.supabase.com
# SUPABASE_DB_PASSWORD=your-database-password
