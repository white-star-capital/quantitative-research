# `make start` creates .env on first run. Never commit .env.

# Supabase: Connect > Session pooler > URI, with your database password in place of
# [YOUR-PASSWORD] (URL-encode special characters; wrap the value in single quotes if it has a $).
# Leave this out to run a local Postgres container instead.
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnopqrst:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Local Postgres container only (generated)
POSTGRES_PASSWORD=change-me
FRONTEND_PORT=3000
